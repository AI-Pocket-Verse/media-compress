{
  "name": "media-compress",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted image & video compression and watermark removal, powered by FFmpeg",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "scripts": {
    "bootstrap": "node -e \"const fs=require('fs');if(!fs.existsSync('api/.env.dev'))fs.copyFileSync('api/.env.example','api/.env.dev')\" && pnpm --filter @media-compress/api db:migrate",
    "dev": "pnpm --parallel --filter @media-compress/api --filter @media-compress/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "demo-video": "node scripts/demo-media.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "overrides": {
      "glob@10": ">=10.5.0 <11",
      "micromatch": ">=4.0.8"
    }
  }
}
