[Unit]
Description=media-compress API
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__/api
EnvironmentFile=__INSTALL_DIR__/api/.env.prod
# Workspace packages are consumed as TS source, so the tsx loader is required
ExecStart=/usr/bin/node --import tsx __INSTALL_DIR__/api/dist/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# Sandboxing
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

# Resource limits
LimitNOFILE=4096
MemoryMax=4G

[Install]
WantedBy=multi-user.target
