server {
    listen 80;
    server_name __SERVER_NAME__;

    # Match MAX_UPLOAD_BYTES (2 GB default).
    client_max_body_size 2G;
    client_body_timeout 600s;

    # Long-running media processing
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # Static frontend (built artifact)
    root __INSTALL_DIR__/web/dist;
    index index.html;

    # API + file streams proxy to Node
    location ~ ^/(api|outputs|thumbnails)/ {
        proxy_pass http://127.0.0.1:4010;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    access_log /var/log/nginx/media-compress.access.log;
    error_log  /var/log/nginx/media-compress.error.log;
}
