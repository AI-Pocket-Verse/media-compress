{
  "name": "@media-compress/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=.env.dev src/index.ts",
    "build": "tsc",
    "start": "node --import tsx --env-file=.env.prod dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:migrate": "node --env-file=.env.dev node_modules/prisma/build/index.js migrate dev",
    "db:migrate:prod": "node --env-file=.env.prod node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.8",
    "@media-compress/api-kit": "workspace:*",
    "@media-compress/auth-client-api": "workspace:*",
    "@media-compress/db-kit": "workspace:*",
    "@prisma/client": "5.22.0",
    "archiver": "^7.0.1",
    "fastify": "5.12.8",
    "p-queue": "^8.0.1",
    "tsx": "^4.16.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@media-compress/tsconfig": "workspace:*",
    "@types/archiver": "^6.0.3",
    "@types/node": "^20.14.10",
    "prisma": "5.22.0",
    "typescript": "5.4.5",
    "vitest": "4.1.12"
  }
}
