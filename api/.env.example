# media-compress API — copy this file to .env.dev (local) or .env.prod (server)
# and adjust. Loaded via Node's native --env-file= flag.

NODE_ENV=development
PORT=4010
HOST=127.0.0.1

# SQLite (Prisma). A relative file: path resolves against api/prisma/, so this
# lands at api/prisma/dev.db (gitignored). Prod: use an ABSOLUTE path, e.g.
# file:/var/lib/media-compress/media-compress.db
DATABASE_URL=file:./dev.db

# File storage (uploads/, outputs/, thumbnails/, cleaner.log) is derived from
# BASE_DIR. Override the individual paths only to split storage across volumes.
BASE_DIR=./data
# UPLOAD_DIR=
# OUTPUT_DIR=
# THUMBNAIL_DIR=
# CLEANER_LOG=

# Optional login. Leave unset for local single-user mode (no login at all).
# To require Feishu login, deploy the companion feishu-sso service and point
# this at its whoami endpoint (web must also set VITE_SSO_BASE, see README).
# WHOAMI_URL=http://localhost:4020/api/whoami

# Worker
WORKER_COUNT=1

# Limits (bytes / days)
# MAX_STORAGE_BYTES=5368709120   # 5 GB
# LRU_CLEANUP_BYTES=1073741824   # 1 GB
# MAX_AGE_DAYS=180
# PROTECTION_DAYS=30
# MAX_UPLOAD_BYTES=2147483648    # 2 GB
# FFMPEG_TIMEOUT_MS=600000

# FFmpeg binaries (absolute path on server, e.g. /usr/bin/ffmpeg). On macOS,
# webp output needs `brew install ffmpeg-full`, which is not on PATH:
# /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg (Intel: /usr/local/opt/...).
# See README "FFmpeg 要求" for which formats need which encoders.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# CORS — leave empty when web and api share one origin (vite proxy / nginx).
# Set comma-separated origins only for direct cross-origin browser access.
CORS_ORIGINS=
